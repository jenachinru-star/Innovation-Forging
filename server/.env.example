# OpenAI Next 中转站：对话 / 图片 / 视频 / 语音转写共用同一组 base-url 与 key
OPENAI_NEXT_BASE_URL=https://api.openai-next.com/v1
OPENAI_NEXT_API_KEY=

# 对话模型（剧本生成 / 解析 / 讨论纪要）
CHAT_MODEL=gpt-5.4-mini

# 图片模型（人物定妆图 / 场景视觉图）
IMAGE_MODEL=doubao-seedream-5-5-261028

# 视频模型（文生 / 图生视频）
VIDEO_MODEL=doubao-seedance-2-5-flash-261115
VIDEO_RESOLUTION=720p
VIDEO_GENERATE_AUDIO=true

# 语音转写模型
ASR_MODEL=whisper-1

PORT=3001
